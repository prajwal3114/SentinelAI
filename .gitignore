# =============================================================================
# SentinelAI — .gitignore
# Covers: Node.js, Python, Docker, Secrets, Telemetry, IDE, OS
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets & Environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/


# -----------------------------------------------------------------------------
# Node.js  (api-gateway, payment-service, order-service, frontend)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.yarn/

# Build output
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/

# Runtime
*.pid
*.seed
*.pid.lock
.node_repl_history

# Test coverage
coverage/
.nyc_output/
lcov.info


# -----------------------------------------------------------------------------
# Python  (backend/, ai-agent/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Distribution / packaging
*.egg
*.egg-info/
eggs/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.tox/
.nox/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
test-results/

# Mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Celery
celerybeat-schedule
celerybeat.pid


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.docker/


# -----------------------------------------------------------------------------
# PostgreSQL / Redis local data
# -----------------------------------------------------------------------------
dummy-production/postgres/data/
dummy-production/redis/data/
pgdata/
redisdata/


# -----------------------------------------------------------------------------
# Telemetry data directories
# -----------------------------------------------------------------------------
telemetry-config/data/
loki-data/
prometheus-data/
grafana-data/


# -----------------------------------------------------------------------------
# AI / LangGraph / Vector DB  (ai-agent — future)
# -----------------------------------------------------------------------------
*.faiss
*.index
chroma_db/
vector_store/
embeddings_cache/
.langchain/
langgraph_checkpoints/
openai_cache/


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
log/


# -----------------------------------------------------------------------------
# IDEs & Editors
# -----------------------------------------------------------------------------
# VSCode — track shared settings, ignore personal overrides
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory


# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/
scratch/
